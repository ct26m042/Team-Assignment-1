{
  "primitive": {
    "color": {
      "ink": "#14211F",
      "paper": "#F4F1EA",
      "teal": "#0C5C56",
      "sand": "#E4DDD0",
      "mist": "#4E5A53"
    },
    "space": {
      "1": "0.25rem",
      "2": "0.5rem",
      "3": "0.75rem",
      "4": "1rem",
      "5": "1.5rem",
      "6": "2rem",
      "7": "3rem",
      "8": "4rem"
    },
    "fontSize": {
      "sm": "0.875rem",
      "md": "1rem",
      "lg": "1.25rem",
      "xl": "1.5rem",
      "2xl": "2.25rem"
    },
    "fontFamily": {
      "sans": "\"Segoe UI\", system-ui, sans-serif",
      "serif": "Georgia, \"Palatino Linotype\", serif"
    }
  },
  "semantic": {
    "color-surface": "{primitive.color.paper}",
    "color-text-primary": "{primitive.color.ink}",
    "color-text-muted": "{primitive.color.mist}",
    "color-accent": "{primitive.color.teal}",
    "color-on-accent": "{primitive.color.paper}",
    "color-border": "{primitive.color.sand}",
    "space-page": "{primitive.space.6}",
    "font-body": "{primitive.fontFamily.sans}",
    "font-display": "{primitive.fontFamily.serif}",
    "font-size-body": "{primitive.fontSize.md}",
    "font-size-display": "{primitive.fontSize.2xl}"
  }
}
